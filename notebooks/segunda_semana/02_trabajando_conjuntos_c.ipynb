    "from itertools import product\n",
    "\n",
    "camisetas = [\"C1\", \"C2\", \"C3\"]\n",
    "pantalones = [\"P1\", \"P2\"]\n",
    "zapatos = [\"Z1\", \"Z2\"]\n",
    "\n",
    "outfits = list(product(camisetas, pantalones, zapatos))\n",
    "print(f\"Número total de outfits: {len(outfits)}\")"
   ]
  }
